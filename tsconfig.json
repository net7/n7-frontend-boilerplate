{
  "compileOnSave": false,
  "angularCompilerOptions": { 
    "fullTemplateTypeCheck": true, 
    "strictInjectionParameters": true, 
    "enableIvy": false 
  },
  "compilerOptions": {
    "baseUrl": "./",
    "downlevelIteration": true,
    "importHelpers": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es5", // "target": "es2015",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom"
    ],
    "paths": {
      "@n7-frontend/boilerplate": [
        "projects/n7-boilerplate-lib/src/public-api"
      ],
      "@n7-frontend/boilerplate/*": [
        "projects/n7-boilerplate-lib/src/*"
      ],
      // MURUCA PROJECT PATHS
     // "@mr-routes": ["src/app/app.routes.muruca.ts"],
     // "@mr-config": ["src/app/config-muruca/"],
     // "@mr-config/*": ["src/app/config-muruca/*"],
      "@mr-routes": ["../../muruca-fe/carte-trentine-fe/src/app/app.routes.ts"],
      "@mr-config": ["../../muruca-fe/carte-trentine-fe/src/app/config"],
      "@mr-config/*": ["../../muruca-fe/carte-trentine-fe/src/app/config/*"],
      // ARIANNA PROJECT PATHS
      "@aw-routes": ["src/app/app.routes.arianna.ts"],
      "@aw-config": ["src/app/config-arianna/"],
      "@aw-config/*": ["src/app/config-arianna/*"],
      // "@aw-routes": ["<PROJECT-LOCAL-PATH>/src/app/app.routes.ts"],
      // "@aw-config": ["<PROJECT-LOCAL-PATH>/src/app/config-arianna/"],
      // "@aw-config/*": ["<PROJECT-LOCAL-PATH>/src/app/config-arianna/*"],
    }
  }
}
