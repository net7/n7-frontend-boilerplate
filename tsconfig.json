{
  "compileOnSave": false,
  "angularCompilerOptions": { 
    "fullTemplateTypeCheck": true, 
    "strictInjectionParameters": true, 
    "enableIvy": false 
  },
  "compilerOptions": {
    "baseUrl": "./",
    "downlevelIteration": true,
    "importHelpers": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "target": "es2020", // "target": "es2015",
    "allowSyntheticDefaultImports" : true,
    "skipLibCheck": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom",
      "dom.iterable"
    ],
    "paths": {
      "@net7/boilerplate-common": [
        "projects/n7-boilerplate-common/src/public-api"
      ],
      "@net7/boilerplate-arianna": [
        "projects/n7-boilerplate-arianna/src/public-api"
      ],
      "@net7/boilerplate-muruca": [
        "projects/n7-boilerplate-muruca/src/public-api"
      ],
      "@net7/boilerplate-dataviz": [
        "projects/n7-boilerplate-dataviz/src/public-api"
      ],
      // MURUCA PROJECT PATHS
      // ------------------------------------------------------------------->
      "@mr-routes": ["src/app/app.routes.muruca.ts"],
      "@mr-config": ["src/app/config-muruca/"],
      "@mr-config/*": ["src/app/config-muruca/*"],
      // "@mr-routes": ["../../teatro-caballeresco-fe/src/app/app.routes.ts"],
      // "@mr-config": ["../../teatro-caballeresco-fe/src/app/config"],
      // "@mr-config/*": ["../../teatro-caballeresco-fe/src/app/config/*"],
      // ARIANNA PROJECT PATHS
      // ------------------------------------------------------------------->
      "@aw-routes": ["src/app/app.routes.arianna.ts"],
      "@aw-config": ["src/app/config-arianna/"],
      "@aw-config/*": [ "src/app/config-arianna/*" ],
      // "@aw-routes": ["<PROJECT-LOCAL-PATH>/src/app/app.routes.ts"],
      // "@aw-config": ["<PROJECT-LOCAL-PATH>/src/app/config-arianna/"],
      // "@aw-config/*": ["<PROJECT-LOCAL-PATH>/src/app/config-arianna/*"],
    }
  }
}
