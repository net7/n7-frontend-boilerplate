{
  "compileOnSave": false,
  "angularCompilerOptions": { 
    "fullTemplateTypeCheck": true, 
    "strictInjectionParameters": true,
  },
  "compilerOptions": {
    "baseUrl": "./",
    "downlevelIteration": true,
    "importHelpers": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "target": "ES2022",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom",
      "dom.iterable"
    ],
    "paths": {
      "@net7/boilerplate-common": [
        "projects/n7-boilerplate-common/src/public-api"
      ],
      "@net7/boilerplate-arianna": [
        "projects/n7-boilerplate-arianna/src/public-api"
      ],
      "@net7/boilerplate-muruca": [
        "projects/n7-boilerplate-muruca/src/public-api"
      ],
      "@net7/boilerplate-dataviz": [
        "projects/n7-boilerplate-dataviz/src/public-api"
      ],
      "@mr-routes": [
        "src/app/app.routes.muruca.ts"
        // "../petrarca-fe/src/app/app.routes.ts" //routes di un progetto in locale
      ],
      "@mr-config": [
        "src/app/config-muruca/"
        // "../petrarca-fe/src/app/config/" //config di un progetto in locale
      ],
      "@mr-config/*": [
        "src/app/config-muruca/*"
        // "../petrarca-fe/src/app/config/*" //config di un progetto in locale
      ],
      "@aw-routes": [
        "src/app/app.routes.arianna.ts"
        // "../a4view/frontend/src/app/app.routes.ts"
      ],
      "@aw-config": [
        "src/app/config-arianna/"
        // "../a4view/frontend/src/app/config"
      ],
      "@aw-config/*": [
        "src/app/config-arianna/*"
        // "../a4view/frontend/src/app/config/*"
      ]
    },
    "useDefineForClassFields": false
  }
}
