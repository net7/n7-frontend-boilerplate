{
  "name": "n7-boilerplate",
  "version": "1.0.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "stylelint": "stylelint \"projects/n7-boilerplate-lib/src/lib/styles/**/**/*.scss\"; exit 0",
    "stylelint:watch": "onchange \"projects/n7-boilerplate-lib/src/lib/styles/**/**/*.scss\" -- npm run stylelint ",
    "e2e": "ng e2e",
    "repackage": "ng build n7-boilerplate-lib",
    "postrepackage": "node scripts/repackage",
    "package:serve": "ng build n7-boilerplate-lib --watch",
    "package:copy": "node scripts/build-after",
    "package:build": "ng build n7-boilerplate-lib && npm run package:copy",
    "update:components": "npm update @n7-frontend/components"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^8.2.5",
    "@angular/common": "^8.2.5",
    "@angular/compiler": "^8.2.5",
    "@angular/core": "^8.2.5",
    "@angular/forms": "^8.2.5",
    "@angular/platform-browser": "^8.2.5",
    "@angular/platform-browser-dynamic": "^8.2.5",
    "@angular/router": "^8.2.5",
    "@n7-frontend/components": "git+ssh://git@github.com/net7/n7-frontend-components-dist.git#master",
    "@n7-frontend/core": "git+ssh://git@github.com/net7/n7-frontend-core.git#develop",
    "@n7-frontend/icon-font": "git+ssh://git@github.com/net7/n7-icon-font.git#master",
    "apexcharts": "^3.8.6",
    "classlist.js": "^1.1.20150312",
    "core-js": "^2.5.4",
    "d3": "^5.12.0",
    "flatpickr": "^4.6.3",
    "lodash": "^4.17.15",
    "openseadragon": "^2.4.1",
    "rxjs": "^6.0.0",
    "slug": "^2.1.1",
    "tippy.js": "^5.1.2",
    "tslib": "^1.10.0",
    "zone.js": "~0.9.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.803.3",
    "@angular-devkit/build-ng-packagr": "~0.803.3",
    "@angular/cli": "~8.3.3",
    "@angular/compiler-cli": "^8.2.5",
    "@angular/language-service": "^8.2.5",
    "@types/jasmine": "~2.8.6",
    "@types/jasminewd2": "~2.0.3",
    "@types/lodash": "^4.14.146",
    "@types/node": "~8.9.4",
    "@typescript-eslint/eslint-plugin": "^2.21.0",
    "@typescript-eslint/parser": "^2.21.0",
    "codelyzer": "^5.0.1",
    "eslint": "^6.8.0",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-plugin-import": "^2.20.1",
    "fs-extra": "^8.1.0",
    "husky": "^4.2.3",
    "jasmine-core": "~2.99.1",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~1.7.1",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~2.0.0",
    "karma-jasmine": "~1.1.1",
    "karma-jasmine-html-reporter": "^0.2.2",
    "lint-staged": "^10.0.8",
    "ng-packagr": "^5.4.0",
    "onchange": "^6.1.0",
    "protractor": "~5.4.0",
    "stylelint": "^11.1.1",
    "stylelint-config-standard": "^19.0.0",
    "ts-node": "~5.0.1",
    "tsickle": "^0.37.0",
    "tslint": "~5.9.1",
    "typescript": "~3.5.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "*.scss": [
      "stylelint --syntax scss --fix"
    ]
  }
}
