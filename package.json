{
  "name": "n7-boilerplate",
  "version": "5.6.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -c muruca",
    "arianna": "ng serve -c arianna",
    "muruca": "ng serve -c muruca",
    "dataviz": "ng serve -c dataviz",
    "build": "npm run build:common && npm run build:muruca && npm run build:arianna && npm run build:dataviz",
    "build:common": "ng build n7-boilerplate-common --configuration production",
    "build:muruca": "ng build n7-boilerplate-muruca --configuration production",
    "build:arianna": "ng build n7-boilerplate-arianna --configuration production",
    "build:dataviz": "ng build n7-boilerplate-dataviz --configuration production",
    "version": "node scripts/sync-version.js && git add projects/*/package.json",
    "test": "ng test",
    "test-n7-boilerplate-common": "ng test n7-boilerplate-common",
    "test-headless-n7-boilerplate-common": "ng test n7-boilerplate-common --watch=false --browsers=ChromeHeadless",
    "test-n7-boilerplate-muruca": "ng test n7-boilerplate-muruca",
    "test-headless-n7-boilerplate-muruca": "ng test n7-boilerplate-muruca --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "stylelint": "stylelint \"projects/**/*.scss\"; exit 0",
    "stylelint:watch": "onchange \"projects/**/*.scss\" -- npm run stylelint ",
    "e2e": "ng e2e",
    "update:components": "npm update @n7-frontend/components"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.11",
    "@angular/common": "^17.3.11",
    "@angular/compiler": "^17.3.11",
    "@angular/core": "^17.3.11",
    "@angular/forms": "^17.3.11",
    "@angular/platform-browser": "^17.3.11",
    "@angular/platform-browser-dynamic": "^17.3.11",
    "@angular/router": "^17.3.11",
    "@n7-frontend/icon-font": "https://github.com/net7/n7-icon-font.git#master",
    "@net7/components": "^4.5.16",
    "@net7/core": "^4.1.0",
    "core-js": "^2.5.4",
    "dayjs": "^1.11.1",
    "leaflet": "^1.6.0",
    "leaflet.markercluster": "^1.4.1",
    "lodash": "^4.17.15",
    "mirador": "4.0.0-alpha.10",
    "moment": "^2.26.0",
    "ngx-extended-pdf-viewer": "19.2.0",
    "rxjs": "^7.0.0",
    "slugify": "^1.4.0",
    "tippy.js": "^5.1.2",
    "tslib": "^2.0.0",
    "zone.js": "^0.14.7"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.8",
    "@angular/cli": "^17.3.8",
    "@angular/compiler-cli": "^17.3.11",
    "@angular/language-service": "^17.3.11",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/lodash": "^4.14.146",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "codelyzer": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "fs-extra": "^8.1.0",
    "husky": "^4.2.3",
    "jasmine-core": "~3.8.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.12",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-firefox-launcher": "^2.1.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "lint-staged": "^10.0.8",
    "ng-packagr": "^17.3.0",
    "onchange": "^6.1.0",
    "protractor": "~7.0.0",
    "puppeteer": "^19.5.2",
    "stylelint": "^11.1.1",
    "stylelint-config-standard": "^19.0.0",
    "ts-node": "~7.0.0",
    "tslint": "~6.1.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.46.4",
    "vis-network": "^9.1.12",
    "vis-timeline": "^7.7.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "*.scss": [
      "stylelint --syntax scss --fix"
    ]
  },
  "volta": {
    "node": "24.14.1"
  }
}
