{
  "name": "n7-boilerplate",
  "version": "2.39.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "arianna": "ng serve -c arianna",
    "muruca": "ng serve -c muruca",
    "dataviz": "ng serve -c dataviz",
    "build": "ng build n7-boilerplate-lib --prod",
    "postbuild": "node scripts/build-after",
    "test": "ng test",
    "lint": "ng lint",
    "stylelint": "stylelint \"projects/n7-boilerplate-lib/src/lib/styles/**/**/*.scss\"; exit 0",
    "stylelint:watch": "onchange \"projects/n7-boilerplate-lib/src/lib/styles/**/**/*.scss\" -- npm run stylelint ",
    "e2e": "ng e2e",
    "update:components": "npm update @n7-frontend/components"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^9.1.10",
    "@angular/common": "^9.1.10",
    "@angular/compiler": "^9.1.10",
    "@angular/core": "^9.1.10",
    "@angular/forms": "^9.1.10",
    "@angular/platform-browser": "^9.1.10",
    "@angular/platform-browser-dynamic": "^9.1.10",
    "@angular/router": "^9.1.10",
    "@n7-frontend/components": "git://github.com/net7/n7-frontend-components-dist.git#master",
    "@n7-frontend/core": "git://github.com/net7/n7-frontend-core.git#master",
    "@n7-frontend/icon-font": "git://github.com/net7/n7-icon-font.git#master",
    "classlist.js": "^1.1.20150312",
    "core-js": "^2.5.4",
    "leaflet": "^1.6.0",
    "leaflet.markercluster": "^1.4.1",
    "lodash": "^4.17.15",
    "moment": "^2.26.0",
    "ngx-extended-pdf-viewer": "^7.3.2",
    "rxjs": "6.5.5",
    "slugify": "^1.4.0",
    "tippy.js": "^5.1.2",
    "tslib": "^1.10.0",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.901.7",
    "@angular-devkit/build-ng-packagr": "~0.901.7",
    "@angular/cli": "~9.1.7",
    "@angular/compiler-cli": "^9.1.10",
    "@angular/language-service": "^9.1.10",
    "@types/jasmine": "~2.8.6",
    "@types/jasminewd2": "~2.0.3",
    "@types/lodash": "^4.14.146",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "^2.21.0",
    "@typescript-eslint/parser": "^2.21.0",
    "codelyzer": "^5.1.2",
    "eslint": "^6.8.0",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-plugin-import": "^2.20.1",
    "fs-extra": "^8.1.0",
    "husky": "^4.2.3",
    "jasmine-core": "~2.99.1",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~1.7.1",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~2.0.0",
    "karma-jasmine": "~1.1.1",
    "karma-jasmine-html-reporter": "^0.2.2",
    "lint-staged": "^10.0.8",
    "ng-packagr": "^9.0.0",
    "onchange": "^6.1.0",
    "protractor": "~5.4.0",
    "stylelint": "^11.1.1",
    "stylelint-config-standard": "^19.0.0",
    "ts-node": "~5.0.1",
    "tslint": "~5.9.1",
    "typescript": "~3.8.3",
    "vis-timeline": "~7.3.6"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "*.scss": [
      "stylelint --syntax scss --fix"
    ]
  }
}
