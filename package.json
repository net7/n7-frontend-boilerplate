{
  "name": "n7-boilerplate",
  "version": "4.4.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "arianna": "ng serve -c arianna",
    "muruca": "ng serve -c muruca",
    "dataviz": "ng serve -c dataviz",
    "build": "npm run build:common && npm run build:muruca && npm run build:arianna && npm run build:dataviz",
    "build:common": "ng build n7-boilerplate-common --configuration production",
    "build:muruca": "ng build n7-boilerplate-muruca --configuration production",
    "build:arianna": "ng build n7-boilerplate-arianna --configuration production",
    "build:dataviz": "ng build n7-boilerplate-dataviz --configuration production",
    "version": "node scripts/sync-version.js && git add projects/*/package.json",
    "test": "ng test",
    "lint": "ng lint",
    "stylelint": "stylelint \"projects/**/*.scss\"; exit 0",
    "stylelint:watch": "onchange \"projects/**/*.scss\" -- npm run stylelint ",
    "e2e": "ng e2e",
    "update:components": "npm update @n7-frontend/components"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.2.12",
    "@angular/common": "^14.2.12",
    "@angular/compiler": "^14.2.12",
    "@angular/core": "^14.2.12",
    "@angular/forms": "^14.2.12",
    "@angular/platform-browser": "^14.2.12",
    "@angular/platform-browser-dynamic": "^14.2.12",
    "@angular/router": "^14.2.12",
    "@n7-frontend/icon-font": "https://github.com/net7/n7-icon-font.git#master",
    "@net7/components": "*",
    "@net7/core": "*",
    "core-js": "^2.5.4",
    "dayjs": "^1.11.1",
    "leaflet": "^1.6.0",
    "leaflet.markercluster": "^1.4.1",
    "lodash": "^4.17.15",
    "moment": "^2.26.0",
    "ngx-extended-pdf-viewer": "^14.5.3",
    "rxjs": "^6.6.7",
    "slugify": "^1.4.0",
    "tippy.js": "^5.1.2",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.10",
    "@angular/cli": "^14.2.10",
    "@angular/compiler-cli": "^14.2.12",
    "@angular/language-service": "^14.2.12",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/lodash": "^4.14.146",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "^5.10.2",
    "@typescript-eslint/parser": "^5.10.2",
    "codelyzer": "^6.0.0",
    "eslint": "^8.8.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.25.4",
    "fs-extra": "^8.1.0",
    "husky": "^4.2.3",
    "jasmine-core": "~3.8.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.12",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "lint-staged": "^10.0.8",
    "ng-packagr": "^14.2.2",
    "onchange": "^6.1.0",
    "protractor": "~7.0.0",
    "stylelint": "^11.1.1",
    "stylelint-config-standard": "^19.0.0",
    "ts-node": "~7.0.0",
    "tslint": "~6.1.0",
    "typescript": "~4.8.4",
    "vis-timeline": "~7.3.6"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "*.scss": [
      "stylelint --syntax scss --fix"
    ]
  }
}
