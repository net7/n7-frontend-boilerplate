{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "n7-boilerplate": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "preserveSymlinks": true,
            "fileReplacements": [
              {
                "replace": "src/app/app.module.ts",
                "with": "src/app/app.module.arianna.ts"
              }
            ],
            "outputPath": "dist/n7-boilerplate",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "**/*",
                "input": "./node_modules/@teipublisher/pb-components/dist",
                "output": "/assets/pb-components/dist"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@teipublisher/pb-components/lib",
                "output": "/assets/pb-components/lib"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@teipublisher/pb-components/images",
                "output": "/assets/pb-components/images"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@teipublisher/pb-components/i18n",
                "output": "/assets/pb-components/i18n"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/ngx-extended-pdf-viewer/assets/",
                "output": "/assets/"
              }
            ],
            "styles": [
              "./node_modules/latte-carousel/dist/latte-carousel.min.css",
              "./node_modules/leaflet/dist/leaflet.css",
              "./node_modules/leaflet.markercluster/dist/MarkerCluster.css",
              "./node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
              "./node_modules/vis-timeline/dist/vis-timeline-graph2d.css",
              "src/styles/styles.arianna.scss"
            ],
            "scripts": [],
            "vendorChunk": true,
            "extractLicenses": false,
            "buildOptimizer": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "allowedCommonJsDependencies": [
              "apexcharts/dist/apexcharts.common.js",
              "dayjs",
              "latte-carousel",
              "leaflet.markercluster",
              "leaflet",
              "lodash",
              "moment",
              "openseadragon",
              "slugify"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true
            },
            "arianna": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/app/app.module.ts",
                  "with": "src/app/app.module.arianna.ts"
                }
              ],
              "styles": [
                "./node_modules/latte-carousel/dist/latte-carousel.min.css",
                "./node_modules/leaflet/dist/leaflet.css",
                "./node_modules/leaflet.markercluster/dist/MarkerCluster.css",
                "./node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
                "./node_modules/vis-timeline/dist/vis-timeline-graph2d.css",
                "src/styles/styles.arianna.scss"
              ]
            },
            "dataviz": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/app/app.module.ts",
                  "with": "src/app/app.module.dataviz.ts"
                }
              ],
              "styles": [
                "./node_modules/flatpickr/dist/flatpickr.min.css",
                "./node_modules/leaflet/dist/leaflet.css",
                "./node_modules/leaflet.markercluster/dist/MarkerCluster.css",
                "./node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
                "src/styles/styles.dataviz.scss"
              ]
            },
            "muruca": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/app/app.module.ts",
                  "with": "src/app/app.module.muruca.ts"
                }
              ],
              "styles": [
                "./node_modules/latte-carousel/dist/latte-carousel.min.css",
                "./node_modules/leaflet/dist/leaflet.css",
                "./node_modules/leaflet.markercluster/dist/MarkerCluster.css",
                "./node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
                "./node_modules/vis-timeline/dist/vis-timeline-graph2d.css",
                "src/styles/styles.muruca.scss"
              ]
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "n7-boilerplate:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "n7-boilerplate:build:production"
            },
            "arianna": {
              "browserTarget": "n7-boilerplate:build:arianna"
            },
            "dataviz": {
              "browserTarget": "n7-boilerplate:build:dataviz"
            },
            "muruca": {
              "browserTarget": "n7-boilerplate:build:muruca"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "n7-boilerplate:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": [
              "src/styles.css"
            ],
            "scripts": [],
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ]
          }
        }
      }
    },
    "n7-boilerplate-e2e": {
      "root": "e2e/",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "n7-boilerplate:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "n7-boilerplate:serve:production"
            }
          }
        }
      }
    },
    "n7-boilerplate-common": {
      "projectType": "library",
      "root": "projects/n7-boilerplate-common",
      "sourceRoot": "projects/n7-boilerplate-common/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/n7-boilerplate-common/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/n7-boilerplate-common/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/n7-boilerplate-common/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/n7-boilerplate-common/src/test.ts",
            "tsConfig": "projects/n7-boilerplate-common/tsconfig.spec.json",
            "karmaConfig": "projects/n7-boilerplate-common/karma.conf.js"
          }
        }
      }
    },
    "n7-boilerplate-arianna": {
      "projectType": "library",
      "root": "projects/n7-boilerplate-arianna",
      "sourceRoot": "projects/n7-boilerplate-arianna/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/n7-boilerplate-arianna/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/n7-boilerplate-arianna/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/n7-boilerplate-arianna/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/n7-boilerplate-arianna/src/test.ts",
            "tsConfig": "projects/n7-boilerplate-arianna/tsconfig.spec.json",
            "karmaConfig": "projects/n7-boilerplate-arianna/karma.conf.js"
          }
        }
      }
    },
    "n7-boilerplate-muruca": {
      "projectType": "library",
      "root": "projects/n7-boilerplate-muruca",
      "sourceRoot": "projects/n7-boilerplate-muruca/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/n7-boilerplate-muruca/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/n7-boilerplate-muruca/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/n7-boilerplate-muruca/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/n7-boilerplate-muruca/src/test.ts",
            "tsConfig": "projects/n7-boilerplate-muruca/tsconfig.spec.json",
            "karmaConfig": "projects/n7-boilerplate-muruca/karma.conf.js"
          }
        }
      }
    },
    "n7-boilerplate-dataviz": {
      "projectType": "library",
      "root": "projects/n7-boilerplate-dataviz",
      "sourceRoot": "projects/n7-boilerplate-dataviz/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/n7-boilerplate-dataviz/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/n7-boilerplate-dataviz/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/n7-boilerplate-dataviz/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/n7-boilerplate-dataviz/src/test.ts",
            "tsConfig": "projects/n7-boilerplate-dataviz/tsconfig.spec.json",
            "karmaConfig": "projects/n7-boilerplate-dataviz/karma.conf.js"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}