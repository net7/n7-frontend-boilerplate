{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "n7-boilerplate": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "aot": true,
            "preserveSymlinks": true,
            "fileReplacements": [
              {
                "replace": "src/assets/app-config.json",
                "with": "src/assets/app-config.arianna.json"
              }, 
              {
                "replace": "src/app/app.module.ts",
                "with": "src/app/app.module.arianna.ts"
              }, 
              {
                "replace": "src/styles/styles.scss",
                "with": "src/styles/styles.arianna.scss"
              }, 
              {
                "replace": "src/app/app.component.html",
                "with": "src/app/app.component-arianna.html"
              }
            ],
            "outputPath": "dist/n7-boilerplate",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              { "glob": "**/*", "input": "./node_modules/@teipublisher/pb-components/dist", "output": "/assets/pb-components/dist" },
              { "glob": "**/*", "input": "./node_modules/@teipublisher/pb-components/lib", "output": "/assets/pb-components/lib" },
              { "glob": "**/*", "input": "./node_modules/@teipublisher/pb-components/images", "output": "/assets/pb-components/images" },
              { "glob": "**/*", "input": "./node_modules/@teipublisher/pb-components/i18n", "output": "/assets/pb-components/i18n" }
            ],
            "styles": [
              "./node_modules/flatpickr/dist/flatpickr.min.css",
              "./node_modules/latte-carousel/dist/latte-carousel.min.css",
              "./node_modules/leaflet/dist/leaflet.css",
              "./node_modules/leaflet.markercluster/dist/MarkerCluster.css",
              "./node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
              "./node_modules/vis-timeline/dist/vis-timeline-graph2d.css",
              "src/styles/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractCss": true,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true
            },
            "arianna": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/assets/app-config.json",
                  "with": "src/assets/app-config.arianna.json"
                }, 
                {
                  "replace": "src/app/app.module.ts",
                  "with": "src/app/app.module.arianna.ts"
                }, 
                {
                  "replace": "src/styles/styles.scss",
                  "with": "src/styles/styles.arianna.scss"
                }, 
                {
                  "replace": "src/app/app.component.html",
                  "with": "src/app/app.component-arianna.html"
                }
              ]
            },
            "dataviz": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/assets/app-config.json",
                  "with": "src/assets/app-config.dataviz.json"
                }, 
                {
                  "replace": "src/app/app.module.ts",
                  "with": "src/app/app.module.dataviz.ts"
                }, 
                {
                  "replace": "src/styles/styles.scss",
                  "with": "src/styles/styles.dataviz.scss"
                }, 
                {
                  "replace": "src/app/app.component.html",
                  "with": "src/app/app.component-dataviz.html"
                }
              ]
            },
            "sandbox": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/assets/app-config.json",
                  "with": "src/assets/app-config.sandbox.json"
                }, 
                {
                  "replace": "src/app/app.module.ts",
                  "with": "src/app/app.module.sandbox.ts"
                }, 
                {
                  "replace": "src/styles/styles.scss",
                  "with": "src/styles/styles.sandbox.scss"
                }, 
                {
                  "replace": "src/app/app.component.html",
                  "with": "src/app/app.component-sandbox.html"
                }
              ]
            },
            "muruca": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/app/app.module.ts",
                  "with": "src/app/app.module.muruca.ts"
                }, 
                {
                  "replace": "src/styles/styles.scss",
                  "with": "src/styles/styles.muruca.scss"
                }, 
                {
                  "replace": "src/app/app.component.html",
                  "with": "src/app/app.component-muruca.html"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "n7-boilerplate:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "n7-boilerplate:build:production"
            },
            "arianna": {
              "browserTarget": "n7-boilerplate:build:arianna"
            }, 
            "dataviz": {
              "browserTarget": "n7-boilerplate:build:dataviz"
            }, 
            "sandbox": {
              "browserTarget": "n7-boilerplate:build:sandbox"
            }, 
            "muruca": {
              "browserTarget": "n7-boilerplate:build:muruca"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "n7-boilerplate:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": [
              "src/styles.css"
            ],
            "scripts": [],
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ]
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "src/tsconfig.app.json",
              "src/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    },
    "n7-boilerplate-e2e": {
      "root": "e2e/",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "n7-boilerplate:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "n7-boilerplate:serve:production"
            }
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": "e2e/tsconfig.e2e.json",
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    },
    "n7-boilerplate-lib": {
      "projectType": "library",
      "root": "projects/n7-boilerplate-lib",
      "sourceRoot": "projects/n7-boilerplate-lib/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-ng-packagr:build",
          "options": {
            "tsConfig": "projects/n7-boilerplate-lib/tsconfig.lib.json",
            "project": "projects/n7-boilerplate-lib/ng-package.json"
          }
        ,          "configurations": {
            "production": {
              "tsConfig": "projects/n7-boilerplate-lib/tsconfig.lib.prod.json"
            }
          }
},
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/n7-boilerplate-lib/src/test.ts",
            "tsConfig": "projects/n7-boilerplate-lib/tsconfig.spec.json",
            "karmaConfig": "projects/n7-boilerplate-lib/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "projects/n7-boilerplate-lib/tsconfig.lib.json",
              "projects/n7-boilerplate-lib/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    }
  },
  "defaultProject": "n7-boilerplate"
}
